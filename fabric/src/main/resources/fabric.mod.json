{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "cosmetic hats for supporters of team galena",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/${repository}",
    "issues": "https://github.com/${repository}/issues"
  },
  "license": "https://github.com/${repository}/blob/1.20.x/LICENSE.txt",
  "environment": "*",
  "entrypoints": {
    "client": [
      "galena.hats.fabric.FabricClientEntrypoint"
    ],
    "server": [
      "galena.hats.fabric.FabricServerEntrypoint"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19",
    "fabric-api": "*",
    "minecraft": ">=26.1.2",
    "java": ">=25"
  }
}
